{
  "name": "elektrk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:extensions": "psql \"$DATABASE_URL_UNPOOLED\" -f scripts/db/enable-extensions.sql",
    "db:auth:migrate": "psql \"$DATABASE_URL_UNPOOLED\" -f scripts/db/auth-migration.sql",
    "db:verify": "psql \"$DATABASE_URL_UNPOOLED\" -f scripts/db/verify-schema.sql",
    "payload:types": "bun node_modules/payload/bin.js --disable-transpile generate:types",
    "payload:importmap": "bun node_modules/payload/bin.js --disable-transpile generate:importmap",
    "payload:migrate:create": "bun node_modules/payload/bin.js --disable-transpile migrate:create",
    "payload:migrate": "bun node_modules/payload/bin.js --disable-transpile migrate",
    "seed:products": "bun scripts/seed/seed-products.ts"
  },
  "dependencies": {
    "@auth/neon-adapter": "^1.11.2",
    "@neondatabase/serverless": "^1.1.0",
    "@payloadcms/db-postgres": "^3.84.1",
    "@payloadcms/email-resend": "^3.84.1",
    "@payloadcms/next": "^3.84.1",
    "@payloadcms/richtext-lexical": "^3.84.1",
    "@payloadcms/storage-uploadthing": "^3.85.0",
    "@payloadcms/translations": "^3.84.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "graphql": "^16.14.0",
    "lucide-react": "^1.14.0",
    "motion": "^12.38.0",
    "next": "16.2.6",
    "next-auth": "^5.0.0-beta.31",
    "payload": "^3.84.1",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.7.0",
    "sharp": "^0.34.5",
    "stripe": "^17.7.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
